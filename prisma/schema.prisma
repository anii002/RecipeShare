generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  recipes   Recipe[]
  createdAt DateTime @default(now())
}

model Recipe {
  id          String   @id @default(uuid())
  title       String
  description String
  ingredients String
  steps       String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}
